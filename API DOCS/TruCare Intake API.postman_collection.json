  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{admin_username}}\",\"password\":\"{{admin_password}}\"}"
            },
            "description": "Authenticate an admin user and store access/refresh tokens into the active Postman environment.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Login succeeded', function () {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "const data = pm.response.json();",
                    "if (data.access) {",
                    "    pm.environment.set('access_token', data.access);",
                    "}",
                    "if (data.refresh) {",
                    "    pm.environment.set('refresh_token', data.refresh);",
                    "}",
                    "pm.test('Tokens stored', function () {",
                    "    pm.expect(pm.environment.get('access_token')).to.be.a('string');",
                    "    pm.expect(pm.environment.get('refresh_token')).to.be.a('string');",
                    "});"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/api/auth/refresh/",
            "body": {
              "mode": "raw",
              "raw": "{\"refresh\":\"{{refresh_token}}\"}"
            },
            "description": "Exchange the stored refresh token for a new access token.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Refresh succeeded', function () {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "const data = pm.response.json();",
                    "if (data.access) {",
                    "    pm.environment.set('access_token', data.access);",
                    "}",
                    "pm.test('Access token updated', function () {",
                    "    pm.expect(pm.environment.get('access_token')).to.be.a('string');",
                    "});"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/me/",
            "description": "Fetch the authenticated user profile using the current bearer token."
          }
        }
      ]
    },
