  "info": {
    "_postman_id": "6d1f1a7b-9d7a-4c69-9e2d-1c8c8f1a0d21",
    "name": "TruCare Intake API",
    "description": "Postman collection generated from the TruCare OpenAPI schema.\n\nUse the Authentication folder first to store access and refresh tokens into your environment. The collection is organized by functional areas so it can be shared with frontend developers for integration testing.",
